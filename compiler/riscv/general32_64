#%Module

proc ModulesHelp {} {
	puts stderr {    Riscv - loads the general riscv software & application environment}
	puts stderr {}
}

module-whatis {loads the general riscv32/64 environment and spike simulator}

conflict compiler/riscv

setenv RISCV /software/riscv/
set SPIKE_INSTALL_DIR /software/riscv/spike/

prepend-path PATH [getenv RISCV]/bin
prepend-path PATH [getenv SPIKE_INSTALL_DIR]/bin
prepend-path LD_LIBRARY_PATH [getenv RISCV]/lib
prepend-path LD_LIBRARY_PATH [getenv SPIKE_INSTALL_DIR]/lib