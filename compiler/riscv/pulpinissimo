#%Module

proc ModulesHelp {} {
	puts stderr {    Powerpc - loads the Pulpinissimo software & application environment}
	puts stderr {}
}

module-whatis {loads the Pulpinissimo environment}

conflict compiler/riscv

setenv MTI_VCO_MODE 64
setenv PULP_RISCV_GCC_TOOLCHAIN /opt/riscv
export RISCV /opt/riscv

prepend-path PATH [getenv PULP_RISCV_GCC_TOOLCHAIN]/bin