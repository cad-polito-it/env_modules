#%Module

proc ModulesHelp {} {
	puts stderr {    Powerpc - loads the Powerpc 4.9-4 software & application environment}
	puts stderr {}
}

module-whatis {loads the Powerpc 4.9-4 environment}

conflict compiler/ppc

setenv PPC_PATH /software/spc5_studio

prepend-path PATH [getenv PPC_PATH]/plugins/com.st.tools.spc5.tools.gnu.gcc.ppcvle.linux_4.9.4.20210927153656/toolchain/bin/