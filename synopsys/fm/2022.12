#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys FM 2022.12 - loads the FM 2022.12 software & application environment}
    puts stderr {}
}

module-whatis {loads the FM2022.12 environment}

conflict synopsys/fm

setenv SNPS_FM /eda/synopsys/2022-23/RHELx86/FM_2022.12

prepend-path PATH [getenv SNPS_FM]/bin
prepend-path MANPATH [getenv SNPS_FM]/doc/fm/man

setenv SNPSLMD_LICENSE_FILE [getenv LICENSE_SERVICES]
