#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys STARRC 2022.12 - loads the STARRC 2022.12 software & application environment}
    puts stderr {}
}

module-whatis {loads the STARRC 2022.12 environment}

conflict synopsys/starrc

setenv SNPS_STARRC /eda/synopsys/2022-23/RHELx86/STARRC_2022.12
setenv STAR_RCXT_HOME_DIR [getenv SNPS_STARRC]

prepend-path PATH [getenv SNPS_STARRC]/bin

setenv SNPSLMD_LICENSE_FILE [getenv LICENSE_SERVICES]
