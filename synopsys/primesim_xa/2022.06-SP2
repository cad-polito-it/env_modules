#%Module

proc ModulesHelp {} {
puts stderr { Synopsys PSIM XA 2022.06 SP2 - loads the PSIM XA 2022.06 SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the PSIM XA 2022.06 SP2 environment}

conflict synopsys/primesim_xa

setenv SNPS_PSIM_XA /eda/synopsys/2022-23/RHELx86/PRIMESIM-XA_2022.06-SP2
setenv XA_64 1

prepend-path PATH [getenv SNPS_PSIM_XA]/bin
