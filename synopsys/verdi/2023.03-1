#%Module

proc ModulesHelp {} {
puts stderr { Synopsys Verdi 2023.03-1 - loads the Verdi 2023.03-1 software & application environment}
puts stderr {}
}

module-whatis {loads the Verdi 2023.03-1 environment}

conflict synopsys/verdi

setenv SNPS_VERDI /software/synopsys/verdi/U-2023.03-1
setenv VERDI_HOME [getenv SNPS_VERDI]

prepend-path PATH [getenv SNPS_VERDI]/bin
