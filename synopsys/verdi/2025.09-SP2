#%Module

proc ModulesHelp {} {
puts stderr { Synopsys Verdi 2025.09-SP2 - loads the Verdi 2025.09-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the Verdi 2025.09-SP2 environment}

conflict synopsys/verdi

setenv SNPS_VERDI /eda/synopsys/2025-26/RHELx86/VERDI_2025.09-SP2
setenv VERDI_HOME [getenv SNPS_VERDI]

prepend-path PATH [getenv SNPS_VERDI]/bin
