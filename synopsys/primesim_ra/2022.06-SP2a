#%Module

proc ModulesHelp {} {
puts stderr { Synopsys PSIM RA 2022.06 SP2a - loads the PSIM RA 2022.06 SP2a software & application environment}
puts stderr {}
}

module-whatis {loads the PSIM RA 2022.06 SP2a environment}

conflict synopsys/primesim_ra

setenv SNPS_PSIM_RA /eda/synopsys/2022-23/RHELx86/PSIM-RA_2022.06-SP2a

prepend-path PATH [getenv SNPS_PSIM_RA]/bin
