#%Module

proc ModulesHelp {} {
puts stderr { Synopsys SYN 2022.12 - loads the SYN 2022.12 software & application environment}
puts stderr {}
}

module-whatis {loads the SYN2022.12 environment}

conflict synopsys/syn

setenv SNPS_SYN /eda/synopsys/2022-23/RHELx86/SYN_2022.12
setenv SYNOPSYS_SYN_ROOT [getenv SNPS_SYN]
setenv SYNOPSYS_LC_ROOT /eda/synopsys/2022-23/RHELx86/LC_2022.03-SP5

prepend-path PATH [getenv SNPS_SYN]/bin
prepend-path MANPATH [getenv SNPS_SYN]/doc/syn/man
