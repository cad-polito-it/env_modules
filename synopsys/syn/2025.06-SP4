#%Module

proc ModulesHelp {} {
puts stderr { Synopsys SYN 2025.06-SP4 - loads the SYN 2025.06-SP4 software & application environment}
puts stderr {}
}

module-whatis {loads the SYN2025.06-SP4 environment}

conflict synopsys/syn

setenv SNPS_SYN /eda/synopsys/2025-26/RHELx86/SYN_2025.06-SP4
setenv SYNOPSYS_SYN_ROOT [getenv SNPS_SYN]
setenv SYNOPSYS_LC_ROOT /eda/synopsys/2025-26/RHELx86/LC_2025.06-SP2

prepend-path PATH [getenv SNPS_SYN]/bin
prepend-path MANPATH [getenv SNPS_SYN]/doc/syn/man
