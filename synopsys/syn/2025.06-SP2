#%Module

proc ModulesHelp {} {
puts stderr { Synopsys SYN 2025.06-SP2 - loads the SYN 2025.06-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the SYN2025.06-SP2 environment}

conflict synopsys/syn

setenv SNPS_SYN /software/synopsys/syn/X-2025.06-SP2/
setenv SYNOPSYS_SYN_ROOT [getenv SNPS_SYN]
setenv SYNOPSYS_LC_ROOT /software/synopsys/lc/X-2025.06-SP1

prepend-path PATH [getenv SNPS_SYN]/bin
prepend-path MANPATH [getenv SNPS_SYN]/doc/syn/man
