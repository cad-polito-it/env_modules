#%Module

proc ModulesHelp {} {
puts stderr { Synopsys HSPICE 2022.12 - loads the HSPICE 2022.12 software & application environment}
puts stderr {}
}

module-whatis {loads the HSPICE 2022.12 environment}

conflict synopsys/hspice

setenv SNPS_HSPICE /eda/synopsys/2022-23/RHELx86/HSPICE_2022.06-SP2/hspice
setenv HSPICE_64 1
setenv CDPL_HOME [getenv SNPS_HSPICE]/cdpl

prepend-path PATH [getenv SNPS_HSPICE]/bin
prepend-path PATH [getenv CDPL_HOME]/bin
