#%Module

proc ModulesHelp {} {
puts stderr { Synopsys HSPICE 2025.06-SP2 - loads the HSPICE 2025.06-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the HSPICE 2025.06-SP2 environment}

conflict synopsys/hspice

setenv SNPS_HSPICE /eda/synopsys/2025-26/RHELx86/HSPICE_2025.06-SP2/hspice
setenv HSPICE_64 1
setenv CDPL_HOME [getenv SNPS_HSPICE]/cdpl

prepend-path PATH [getenv SNPS_HSPICE]/bin
prepend-path PATH [getenv CDPL_HOME]/bin
