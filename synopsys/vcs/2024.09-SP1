#%Module

proc ModulesHelp {} {
puts stderr { Synopsys VCS 2024.09-SP1 - loads the VCS 2024.09-SP1 software & application environment}
puts stderr {}
}

module-whatis {loads the VCS 2024.09-SP1 environment}

conflict synopsys/vcs

setenv VCS_HOME /eda/synopsys/2024-25/RHELx86/VCS_2024.09-SP1
setenv VCS_TARGET_ARCH amd64


prepend-path PATH [getenv VCS_HOME]/bin
prepend-path MANPATH [getenv VCS_HOME]/doc/man
