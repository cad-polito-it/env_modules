#%Module

proc ModulesHelp {} {
puts stderr { Synopsys VCS_2025.06-SP2 - loads the VCS_2025.06-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the VCS_2025.06-SP2 environment}

conflict synopsys/vcs

setenv VCS_HOME /eda/synopsys/2025-26/RHELx86/VCS_2025.06-SP2/
setenv VCS_TARGET_ARCH amd64


prepend-path PATH [getenv VCS_HOME]/bin
prepend-path MANPATH [getenv VCS_HOME]/doc/man

