#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys VCS 2023.03 SP2 - loads the VCS 2023.03 SP2 software & application environment}
    puts stderr {}
}

module-whatis {loads the VCS 2023.03 SP2 environment}

conflict synopsys/vcs

setenv VCS_HOME /software/synopsys/vcs/U-2023.03-SP2
setenv VCS_TARGET_ARCH amd64


prepend-path PATH [getenv VCS_HOME]/bin
prepend-path MANPATH [getenv VCS_HOME]/doc/man

setenv SNPSLMD_LICENSE_FILE [getenv LICENSE_SERVICES]
