#%Module

proc ModulesHelp {} {
puts stderr { Synopsys ESP 2022.12 - loads the ESP 2022.12 software & application environment}
puts stderr {}
}

module-whatis {loads the ESP2022.12 environment}

conflict synopsys/esp

setenv SNPS_ESP /eda/synopsys/2022-23/RHELx86/ESP_2022.12
setenv SYNOPSYS_ESP_ROOT [getenv SNPS_ESP]
setenv SYNOPSYS_LC_ROOT /eda/synopsys/2022-23/RHELx86/LC_2022.03-SP5

prepend-path PATH [getenv SNPS_ESP]/bin
prepend-path MANPATH [getenv SNPS_ESP]/doc/esp/man
