#%Module

proc ModulesHelp {} {
puts stderr { Synopsys TMAX 2024.09-SP2 - loads the TestMAX 2024.09-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the TestMAX 2024.09-SP2 environment}

conflict synopsys/tmax

setenv SNPS_TMAX /eda/synopsys/2024-25/RHELx86/TMAX_2024.09-SP2
setenv SYNOPSYS_TMAX [getenv SNPS_TMAX]

prepend-path PATH [getenv SNPS_TMAX]/bin
