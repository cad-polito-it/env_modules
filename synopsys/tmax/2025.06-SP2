#%Module

proc ModulesHelp {} {
puts stderr { Synopsys TestMAX 2025.06-SP2 - loads the TestMAX 2025.06-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the TestMAX 2025.06-SP2 environment}

conflict synopsys/tmax

setenv SNPS_TMAX /eda/synopsys/2025-26/RHELx86/TESTMAX_2025.06-SP2
setenv SYNOPSYS_TMAX [getenv SNPS_TMAX]

prepend-path PATH [getenv SNPS_TMAX]/bin
prepend-path PATH [getenv SNPS_TMAX]/amd64/syn/bin/
