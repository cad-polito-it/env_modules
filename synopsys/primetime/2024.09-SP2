#%Module

proc ModulesHelp {} {
puts stderr { Synopsys PRIMETIME 2024.09-SP2 - loads the PRIMETIME 2024.09-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the PRIMETIME 2024.09-SP2 environment}

conflict synopsys/primetime

setenv SNPS_PT /eda/synopsys/2024-25/RHELx86/PT_2024.09-SP2
setenv SYNOPSYS_LC_ROOT /eda/synopsys/2022-23/RHELx86/LC_2022.03-SP5

prepend-path PATH [getenv SNPS_PT]/bin
append-path MANPATH [getenv SNPS_PT]/doc/pt/man
