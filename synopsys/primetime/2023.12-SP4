#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys PRIMETIME 2023.12-SP4 - loads the PRIMETIME 2023.12-SP4 software & application environment}
    puts stderr {}
}

module-whatis {loads the PRIMETIME 2023.12-SP4 environment}

conflict synopsys/primetime

setenv SNPS_PT /software/synopsys/pt/V-2023.12-SP4
setenv SYNOPSYS_LC_ROOT /eda/synopsys/2022-23/RHELx86/LC_2022.12

prepend-path PATH [getenv SNPS_PT]/bin
append-path MANPATH [getenv SNPS_PT]/doc/pt/man

setenv SNPSLMD_LICENSE_FILE [getenv LICENSE_SERVICES]
