#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys SpyGlass 2023.12 SP1 - loads the SpyGlass 2023.12 SP1 software & application environment}
    puts stderr {}
}

module-whatis {loads the SpyGlass 2023.12 SP1 environment}

conflict synopsys/spyglass

setenv SPYGLASS_HOME /software/synopsys/spyglass/V-2023.12-SP1/SPYGLASS_HOME
setenv SG_HTML_BROWSER /usr/bin/firefox
setenv SG_PDF_VIEWER /usr/bin/xpdf

prepend-path PATH [getenv SPYGLASS_HOME]/bin

setenv SNPSLMD_LICENSE_FILE [getenv LICENSE_SERVICES]
