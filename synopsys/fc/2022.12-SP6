#%Module

proc ModulesHelp {} {
puts stderr { Synopsys Fusion Compiler 2022.12 - loads the Fusion Compiler 2022.12 software & application environment}
puts stderr {}
}

module-whatis {loads the Fusion Compiler 2022.12 environment}

conflict synopsys/fc

setenv SNPS_FC /software/synopsys/fusioncompiler/U-2022.12-SP6

prepend-path PATH [getenv SNPS_FC]/bin
