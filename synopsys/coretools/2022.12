#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys CoreTools 2022.12 - loads the Core Tools 2022.12 software & application environment}
    puts stderr {}
}

module-whatis {loads the CT 2022.12 environment}

conflict synopsys/coretools

setenv CADLS_SERVICES {7000@192.168.42.32:7001@192.168.42.32:7002@192.168.42.32:7003@192.168.42.32:7004@192.168.42.32:7005@192.168.42.32:7006@192.168.42.32:7007@192.168.42.32:7008@192.168.42.32:7009@192.168.42.32:7010@192.168.42.32:7011@192.168.42.32:7012@192.168.42.32:7013@192.168.42.32:7014@192.168.42.32:7015@192.168.42.32:7016@192.168.42.32:7017@192.168.42.32:7018@192.168.42.32:7019@192.168.42.32:7020@192.168.42.32:7021@192.168.42.32:7022@192.168.42.32:7023@192.168.42.32:7024@192.168.42.32:7025@192.168.42.32:7026@192.168.42.32:7027@192.168.42.32:7028@192.168.42.32:7029@192.168.42.32}
setenv LM_LICENSE_FILE [getenv CADLS_SERVICES]
setenv SNPSLMD_LICENSE_FILE [getenv CADLS_SERVICES]

setenv SNPS_CT /eda/synopsys/2022-23/RHELx86/CORETOOLS_2022.12

prepend-path PATH [getenv SNPS_CT]/bin
