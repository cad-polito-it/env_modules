#%Module

proc ModulesHelp {} {
puts stderr { Synopsys Z01X 2022.06-SP2 - loads the Z01X 2022.06-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the Z01X 2022.06-SP2 environment}

conflict synopsys/zoix

setenv SNPS_Z01X /eda/synopsys/2022-23/RHELx86/Z01X_2022.06-SP2
setenv ZOIXHOME [getenv SNPS_Z01X]

prepend-path PATH [getenv SNPS_Z01X]/bin
