#%Module

proc ModulesHelp {} {
puts stderr { Synopsys Z01X 2024.09 - loads the Z01X 2024.09 software & application environment}
puts stderr {}
}

module-whatis {loads the Z01X 2024.09 environment}

conflict synopsys/zoix

setenv SNPS_Z01X /software/synopsys/zoix/W-2024.09
setenv ZOIXHOME [getenv SNPS_Z01X]

prepend-path PATH [getenv SNPS_Z01X]/bin
