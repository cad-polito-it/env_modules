#%Module

proc ModulesHelp {} {
puts stderr { Synopsys Z01X 2023.12 - loads the Z01X 2023.12 software & application environment}
puts stderr {}
}

module-whatis {loads the Z01X 2023.12 environment}

conflict synopsys/zoix

setenv SNPS_Z01X /eda/synopsys/2023-24/RHELx86/Z01X_2023.12
setenv ZOIXHOME [getenv SNPS_Z01X]

prepend-path PATH [getenv SNPS_Z01X]/bin
