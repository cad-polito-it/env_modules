#%Module

proc ModulesHelp {} {
    puts stderr {    Synopsys PRIMEPOWER 2022.12 - loads the PRIMEPOWER 2022.12 software & application environment}
    puts stderr {}
}

module-whatis {loads the PRIMEPOWER 2022.12 environment}

conflict synopsys/primepwr

setenv SYN_PPOWER /eda/synopsys/2022-23/RHELx86/PRIMEPOWER_2022.12
setenv SYNOPSYS_LC_ROOT /eda/synopsys/2022-23/RHELx86/LC_2022.12

prepend-path PATH [getenv SYN_PPOWER]/bin

setenv SNPSLMD_LICENSE_FILE [getenv LICENSE_SERVICES]
