#%Module

proc ModulesHelp {} {
puts stderr { Synopsys LC 2025.06-SP1 - loads the LC 2025.06-SP1 software & application environment}
puts stderr {}
}

module-whatis {loads the LC 2025.06-SP1 environment}

conflict synopsys/lc

setenv SNPS_LC /software/synopsys/lc/X-2025.06-SP1
setenv SYNOPSYS_SYN_ROOT /software/synopsys/syn/X-2025.06-SP2

prepend-path PATH [getenv SNPS_LC]/bin
prepend-path MANPATH [getenv SNPS_LC]/doc/syn/man

append-path LD_LIBRARY_PATH [getenv SNPS_LC]/linux64/lc/shlib
