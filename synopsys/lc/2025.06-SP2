#%Module

proc ModulesHelp {} {
puts stderr { Synopsys LC 2025.06-SP2 - loads the LC 2025.06-SP2 software & application environment}
puts stderr {}
}

module-whatis {loads the LC 2025.06-SP2 environment}

conflict synopsys/lc

setenv SNPS_LC /eda/synopsys/2025-26/RHELx86/LC_2025.06-SP2

setenv SYNOPSYS_SYN_ROOT /eda/synopsys/2025-26/RHELx86/SYN_2025.06-SP4

prepend-path PATH [getenv SNPS_LC]/bin
prepend-path MANPATH [getenv SNPS_LC]/doc/syn/man

append-path LD_LIBRARY_PATH [getenv SNPS_LC]/linux64/lc/shlib
