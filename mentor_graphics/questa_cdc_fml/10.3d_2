#%Module

proc ModulesHelp {} {
    puts stderr {    Siemens Questa CDC FML - loads the Questa CDC FML 10.3d_2 software & application environment}
    puts stderr {}
}

module-whatis {loads the Questa CDC FML 10.3d_2 environment}

conflict siemens/questa-cdc

setenv QUESTA_CDC_HOME /eda/mentor/2014-15/RHELx86/QUESTA-CDC-FML_10.3d_2/linux_x86_64

prepend-path PATH [getenv QUESTA_CDC_HOME]/bin

setenv MGLS_LICENSE_FILE [getenv LICENSE_SERVICES]
