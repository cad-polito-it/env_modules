#%Module

proc ModulesHelp {} {
puts stderr { vipcat - loads the vipcat 11.30_057 software & application environment}
puts stderr {}
}

module-whatis {loads the vipcat 11.30_057 environment}

conflict cadence/vipcat

setenv CADENCE_VIPCAT /eda/cadence/2018-19/RHELx86/VIPCAT_11.30.057_UVM
prepend-path PATH [getenv CADENCE_VIPCAT]/tools/bin
