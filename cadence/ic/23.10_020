#%Module

proc ModulesHelp {} {
puts stderr { ic - loads the ic 23.10_020 software & application environment}
puts stderr {}
}

module-whatis {loads the ic 23.10_020 environment}

conflict cadence/ic

setenv CADENCE_IC /eda/cadence/2023-24/RHELx86/IC_23.10.020
prepend-path PATH [getenv CADENCE_IC]/tools/dfII/bin
set-alias help_cds_ic { $CADENCE_IC/tools/cdnshelp/bin/cdnshelp & } 
