#%Module

proc ModulesHelp {} {
	puts stderr {    rc - loads the rc 14.11_000 software & application environment}
	puts stderr {}
}

module-whatis {loads the rc 14.11_000 environment}

conflict cadence/rc

setenv CADENCE_RC /eda/cadence/2014-15/RHELx86/RC_14.11.000
prepend-path PATH [getenv CADENCE_RC]/tools/bin

setenv CDS_LIC_FILE [getenv LICENSE_SERVICES]