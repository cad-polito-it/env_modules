#%Module

proc ModulesHelp {} {
puts stderr { xcelium - loads the xcelium 18.03_010 software & application environment}
puts stderr {}
}

module-whatis {loads the xcelium 18.03_010 environment}

conflict cadence/xcelium

setenv CADENCE_XCELIUM /eda/cadence/2018-19/RHELx86/XCELIUM_18.03.010
prepend-path PATH [getenv CADENCE_XCELIUM]/tools/cdsgcc/gcc/bin
prepend-path PATH [getenv CADENCE_XCELIUM]/tools/bin
prepend-path PATH [getenv CADENCE_XCELIUM]/bin

set-alias help_cds_xcelium { $CADENCE_XCELIUM/tools/cdnshelp/bin/cdnshelp & } 
