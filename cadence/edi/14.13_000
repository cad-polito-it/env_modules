#%Module

proc ModulesHelp {} {
puts stderr { edi - loads the edi 14.13_000 software & application environment}
puts stderr {}
}

module-whatis {loads the edi 14.13_000 environment}

conflict cadence/edi

setenv CADENCE_EDI /eda/cadence/2014-15/RHELx86/EDI_14.13.000
prepend-path PATH [getenv CADENCE_EDI]/bin
