#%Module

proc ModulesHelp {} {
	puts stderr {    incisive - loads the incisive 15.20_058 software & application environment}
	puts stderr {}
}

module-whatis {loads the incisive 15.20_058 environment}

conflict cadence/incisive

setenv CADENCE_INCISIVE /eda/cadence/2018-19/RHELx86/INCISIVE_15.20.058
prepend-path PATH [getenv CADENCE_INCISIVE]/kits/VerificationKit/bin

setenv CDS_LIC_FILE [getenv LICENSE_SERVICES]